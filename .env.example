# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (ห้ามใส่ค่าจริงในไฟล์นี้)
# ==============================================================================

# Database (PostgreSQL / Neon) - SENSITIVE
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local PostgreSQL สำหรับพัฒนา - SENSITIVE
# ตั้ง DATABASE_URL เป็น postgresql://<user>:<password>@localhost:5432/<db> แล้วรัน `npm run db:env`
# เพื่อสร้างค่าด้านล่างอัตโนมัติ (อย่ากรอกเองถ้าไม่จำเป็น)
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
DATABASE_URL_TEST=""          # ต้องเป็น localhost และชื่อฐานข้อมูลลงท้าย _test (Integration Test จะล้างข้อมูลทุกครั้ง)
SEED_ADMIN_PASSWORD=""        # รหัสผ่านบัญชีแอดมินทดสอบที่ npm run db:seed สร้าง (อย่างน้อย 12 ตัวอักษร)
PG_SUPERUSER_PASSWORD=""      # ใช้เฉพาะเมื่อติดตั้งผ่าน npm run db:install และ POSTGRES_USER ไม่ใช่ postgres

# Auth.js / NextAuth - SENSITIVE
NEXTAUTH_SECRET="generate-a-strong-32-char-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (ถ้าใช้งาน) - SENSITIVE
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email API - SENSITIVE
RESEND_API_KEY="re_sample_123456789"
EMAIL_FROM="Peenoey Trading <noreply@peenoey.com>"

# Telegram Bot API (สำหรับแจ้งเตือนสลิปใหม่และข้อผิดพลาด) - SENSITIVE
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_ADMIN_CHAT_ID="-1001234567890"
# บอทสมาชิก (เชื่อมบัญชี + เตือนก่อนหมดอายุทางแชตส่วนตัว) — ตั้งค่าแล้วรัน `npm run telegram:webhook` หลัง deploy
# TELEGRAM_BOT_USERNAME - NON-SENSITIVE (ชื่อบอทไม่มี @), TELEGRAM_WEBHOOK_SECRET - SENSITIVE (A-Z a-z 0-9 _ - ยาว 32+ ตัว)
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Cron Secret (ป้องกัน /api/cron/check-expiry และ /api/cron/watchdog — ยาว 32+ ตัว สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" ต้องตั้งเหมือนกันใน Vercel และ GitHub Actions) - SENSITIVE
CRON_SECRET=""

# Admin Configuration - NON-SENSITIVE
ADMIN_EMAIL="admin@peenoey.com"

# Public Site Configuration - NON-SENSITIVE
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Gold Hybridshot"
NEXT_PUBLIC_SITE_DOMAIN="peenoey.com"
NEXT_PUBLIC_SUPPORT_TELEGRAM="https://t.me/peenoey_support"
# ลิงก์เชิญ Discord (สาธารณะ) — ตั้งให้ "ไม่หมดอายุ / ไม่จำกัดจำนวนครั้ง" ใน Discord ไม่งั้นปุ่มบนเว็บจะใช้ไม่ได้
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/erJFe57YY"
# ช่องทางติดต่อลูกค้า (หน้าแรก + หน้านโยบาย) — ไม่ตั้ง/รูปแบบผิด = ซ่อนช่องทางนั้น
# อีเมลที่รับเมลได้จริง / LINE Official Account ID (@xxx) / Telegram username (@xxx หรือ https://t.me/xxx)
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_LINE=""
NEXT_PUBLIC_CONTACT_TELEGRAM=""

# ข้อมูลผู้ให้บริการที่แสดงในหน้านโยบาย (/terms, /privacy) - NON-SENSITIVE
# ถ้าไม่ตั้งค่า หน้านโยบายจะแสดง "[รอระบุโดยผู้ให้บริการ]"
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=""
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=""
